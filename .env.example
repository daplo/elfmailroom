PORT=3001
PUBLIC_URL=http://localhost:5173
# Set to your HTTPS origin for production; use port 3001 to preview built apps.
# Optional for direct Node runs; Compose always uses /data/mailroom.sqlite in its persistent mount.
# Defaults to mailroom.sqlite in the project root outside Compose.
# DATABASE_PATH=/absolute/path/mailroom.sqlite
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SALES_ENABLED=false
PRIVACY_URL=/privacy/
TERMS_URL=/terms/

# Server-only: never expose this key in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional automatic email delivery for NEW purchases.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Keep this stable: signs long-lived private purchase links (at least 32 characters).
ORDER_LINK_SECRET=
# Protected admin page at /write/admin; generate the hash with npm run admin-password -w @elf/api.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
MAX_REWRITES_PER_ORDER=5

# Public canonical origin used at build time (never include credentials).
VITE_SITE_URL=https://elfmailroom.com


# Public details shown on the privacy and terms pages. Never put secrets here.
VITE_BUSINESS_NAME=Webz Australia
VITE_BUSINESS_COUNTRY=Australia
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_ABN=
VITE_SUPPORT_EMAIL=
# Actual retention periods/criteria, including letter content, orders, logs and backups.
VITE_PRIVACY_RETENTION=
# Hosting/email providers, processing countries and applicable overseas-transfer safeguards.
VITE_PRIVACY_PROVIDERS=

# Public GA4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after analytics consent.
VITE_GOOGLE_ANALYTICS_ID=
