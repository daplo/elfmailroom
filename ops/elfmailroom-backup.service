[Unit]
Description=Encrypted Elf Mailroom backup and isolated restore verification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
EnvironmentFile=/etc/elfmailroom/backup.env
ExecStart=/usr/bin/flock -n /var/www/elfmailroom/.backup.lock /usr/bin/python3 /var/www/elfmailroom/scripts/backup.py backup
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=2h
